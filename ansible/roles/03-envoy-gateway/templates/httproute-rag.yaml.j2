apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: rag-frontend
  namespace: {{ rag_namespace }}
spec:
  parentRefs:
    - name: aiq-gw
      namespace: {{ envoy_gateway_ns }}
      sectionName: web
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: "{{ rag_route_path }}"
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /
      backendRefs:
        - name: {{ rag_frontend_service }}
          port: {{ rag_frontend_service_port }}
