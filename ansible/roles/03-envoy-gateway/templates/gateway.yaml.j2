apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: aiq-gw
  namespace: {{ envoy_gateway_ns }}
spec:
  gatewayClassName: aiq-eg
  listeners:
    - name: web
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: All
  infrastructure:
    parametersRef:
      group: gateway.envoyproxy.io
      kind: EnvoyProxy
      name: aiq-envoy
