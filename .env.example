# AI-Q-on-Kubernetes Brev Launchable configuration.
#
# Copy to .env for local re-runs. In Brev, these can be supplied as Launchable
# environment variables; brev/setup-wrapper.sh writes the variables it receives
# into .env before running scripts/setup.sh.

# Single-node k3s setup.
K3S_CHANNEL=v1.34
K3S_VERSION=
INSTALL_K3S=true
INSTALL_HELM=true

# Envoy Gateway publishes /aiq and /rag through a real host socket for Brev.
ENVOY_GATEWAY_ENABLED=true
ENVOY_HOST_PORT=3001
ENVOY_WEB_NODEPORT=30080
AIQ_ROUTE_PATH=/aiq
RAG_ROUTE_PATH=/rag

# Brev teaching site placeholder. The UI will be added in a later step.
ENABLE_WORKSHOP=true
WORKSHOP_PORT=3000

# Run only selected Ansible tags, e.g. ANSIBLE_TAGS=k3s ./scripts/setup.sh
ANSIBLE_TAGS=
